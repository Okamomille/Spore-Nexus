{
  "schemaVersion": 1,
  "id": "sporenexus",
  "version": "${version}",
  "name": "Spore Nexus",
  "description": "Spore Nexus is an innovative mod that introduces a resource-gathering system inspired by the world of mushrooms.\nThis mod encourages players to explore and create unique machines to gather resources in creative ways.",
  "authors": [
    "Okamiz"
  ],
  "contact": {
    "homepage": "https://github.com/Okamomille/Spore-Nexus",
    "sources": "https://github.com/Okamomille/Spore-Nexus",
    "issues": "https://github.com/Okamomille/Spore-Nexus/issues"
  },
  "license": "MIT",
  "icon": "assets/sporenexus/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.okamiz.fabric.SporeNexusFabric"
    ],
    "client": [
      "net.okamiz.fabric.client.SporeNexusFabricClient"
    ],
    "jei_mod_plugin": [
      "net.okamiz.fabric.compats.jei.JEIPluginFabric"
    ],
    "jade": [
      "net.okamiz.common.compats.jade.JadePlugin"
    ]
  },
  "mixins": [
    "sporenexus.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "architectury": ">=21.0.7",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*",
    "jade": "*"
  }
}
